# ─────────────────────────────────────────────────────────────────────────────
# QE-Central — PRODUCTION environment template (copy to .env.prod, fill in, keep
# OUT of git). Load with:  docker compose --env-file deploy/.env.prod -f docker-compose.qec.yml up -d
#
# Every value below overrides a DEV DEFAULT baked into docker-compose.qec.yml.
# With NEXUS_ENV=production, app/security/boot_validator.py REFUSES TO BOOT if any
# of the marked secrets is left at its dev default or a KEK is 'local' — so a
# mis-filled prod deploy fails loudly at startup instead of running insecurely.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1) Deployed environment (ACTIVATES the fail-closed boot gate) ─────────────
# Must be 'production' (or 'staging'). Anything else leaves the gate in warn-only
# mode — never ship a client with the default 'development'.
NEXUS_ENV=production

# ── 2) Database credentials (REQUIRED — dev defaults are rejected at boot) ─────
# Generate strong, unique values (e.g. `openssl rand -base64 32`). These MUST
# match the passwords the postgres roles qec / qec_substrate were created with.
QEC_DB_PASSWORD=__CHANGE_ME__strong-unique-secret
QEC_SUBSTRATE_DB_PASSWORD=__CHANGE_ME__strong-unique-secret

# ── 3) JWT / service-token signing secret (REQUIRED — dev default is rejected) ─
# Shared platform convention. Use a high-entropy value; rotate on a schedule.
NEXUS_JWT_SECRET=__CHANGE_ME__high-entropy-signing-secret

# ── 4) Encryption-at-rest KEK (REQUIRED — 'local' is refused outside dev) ──────
# Envelope encryption for stored credentials. Use a real KMS in production; the
# SDK refuses NEXUS_KEK_PROVIDER=local when NEXUS_ENV is deployed.
#   GCP:  provider=gcp  + the fully-qualified KMS key
#   AWS:  provider=aws  + the KMS key ARN
NEXUS_KEK_PROVIDER=gcp
NEXUS_KEK_GCP_KEY=projects/__PROJECT__/locations/__LOC__/keyRings/__RING__/cryptoKeys/__KEY__
# NEXUS_KEK_AWS_ARN=arn:aws:kms:__REGION__:__ACCT__:key/__KEY_ID__

# ── 5) Explorer (crawler) — per-fleet HMAC + dispatch ─────────────────────────
# QEC_EXPLORER_TOKEN MUST be identical on qe-central AND the qe-explorer service
# (the RUNNER_TOKEN pattern). Enable dispatch so 'register app → crawl' works.
QEC_EXPLORER_TOKEN=__CHANGE_ME__shared-hmac-secret-both-sides
QEC_EXPLORER_DISPATCH_ENABLED=true

# ── 6) Fleet scale (OPTIONAL — set together for multi-node) ───────────────────
# Single-node deploys can leave these at their in-memory defaults.
# QEC_ADMISSION_BACKEND=redis
# QEC_DAEMON_LEADER_ELECTION=redis
# QEC_REDIS_URL=redis://redis:6379/3

# ── 7) API rate limit (OPTIONAL — 0 = unlimited; set a ceiling for public) ─────
# QEC_API_RATE_LIMIT=60
