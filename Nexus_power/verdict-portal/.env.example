# VKPower Verdict — portal environment (Vite). Copy to `.env.local`.
# NOTHING here is a secret: the portal holds NO server credentials. The only
# authority it carries is the operator's own JWT, entered at sign-in and kept in
# sessionStorage (cleared on tab close / logout). Never bake a token into a
# build — leave these values secret-free.

# Base URL of the QE-Central API (the service listens on :8093 and serves the
# /api/v1/qec/* routes, plus public /health and /webhooks/*). Leave EMPTY to use
# same-origin relative requests (the dev server proxies /api + /health to :8093;
# in production nginx routes them) — recommended. Set an absolute origin only
# when the portal is served from a different host than the API.
VITE_QEC_API_URL=

# Mock mode: 1 = the typed API client returns representative design data and
# makes ZERO network calls, so the portal runs + demos before the backend is
# reachable. Unset / 0 = talk to the real API at VITE_QEC_API_URL.
VITE_QEC_MOCK=1

# The JWT `aud` (audience) the QE-Central auth gate expects on principal tokens.
# Informational only (the portal decodes + displays it); the server verifies.
VITE_QEC_AUDIENCE=vkpower-verdict
