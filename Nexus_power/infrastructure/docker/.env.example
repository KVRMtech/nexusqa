# ═══════════════════════════════════════════════════════════════
# Nexus QA — Production Docker Compose Environment Variables
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to .env before running docker-compose:
#   cp .env.example .env
#
# IMPORTANT: Change ALL default passwords before production use.
# Never commit .env with real secrets to version control.
# ═══════════════════════════════════════════════════════════════

# ─── Image Registry ──────────────────────────────────────────
# Container registry for pulling pre-built images.
# When using docker-compose build, these are only used for tagging.
REGISTRY=ghcr.io
IMAGE_PREFIX=nexus-qa/nexus
IMAGE_TAG=latest

# ─── Base Image Overrides (for docker-compose build) ─────────
# BASE_IMAGE=nexus-base:latest
# GPU_BASE_IMAGE=nexus-gpu:latest

# ─── Security Secrets ────────────────────────────────────────
# REQUIRED: Generate a strong random secret (min 32 chars).
#   openssl rand -base64 48
NEXUS_JWT_SECRET=CHANGE-ME-generate-with-openssl-rand-base64-48

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=nexus
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=nexusqa

# ─── Neo4j ───────────────────────────────────────────────────
NEO4J_PASSWORD=CHANGE-ME-strong-password

# ─── Redis ───────────────────────────────────────────────────
# Leave empty for no password (production: set a password and
# update REDIS_URL accordingly).
REDIS_PASSWORD=

# ─── Milvus / MinIO ─────────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE-ME-minio-access-key
MINIO_SECRET_KEY=CHANGE-ME-minio-secret-key

# ─── Grafana ─────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE-ME-grafana-admin-password

# ─── Frontend Client ────────────────────────────────────────
# Host port for the web UI (default: 3080, gateway is on 8080).
CLIENT_PORT=3080

# ─── Ollama ──────────────────────────────────────────────────
OLLAMA_PORT=11434
