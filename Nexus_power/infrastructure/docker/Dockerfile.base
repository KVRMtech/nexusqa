# Nexus QA — Base Dockerfile for all Python engines
# Multi-stage build for smaller production images

# Pinned upstream base for reproducible builds. The digest makes a clean rebuild
# deterministic regardless of when `python:3.11-slim` is re-tagged on Docker Hub.
# To refresh: docker manifest inspect python:3.11-slim → update the @sha256 below.
# NOTE: the base image currently deployed on the VM (nexus-base:dev,
# sha256:95bb54a8…, built 2026-05-31) predates this pin — it was built from
# whatever 3.11-slim was current then. This pin governs FUTURE rebuilds only.
FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0 AS base

LABEL maintainer="Nexus QA Platform"
LABEL description="Base image for Nexus engine services"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r nexus && useradd -r -g nexus -m nexus

WORKDIR /app

# Install shared SDK first (cache layer)
COPY sdk/nexus-sdk/ /app/sdk/nexus-sdk/
RUN pip install --no-cache-dir /app/sdk/nexus-sdk/

# Default healthcheck
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:${ENGINE_PORT:-8000}/health || exit 1

USER nexus

CMD ["python", "main.py"]
