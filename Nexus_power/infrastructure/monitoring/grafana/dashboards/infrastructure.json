{
  "annotations": { "list": [] },
  "description": "Infrastructure health — Redis, PostgreSQL, Neo4j, and resource utilization for Nexus QA platform",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "dashboard",
      "title": "Engine Overview",
      "type": "link",
      "url": "/d/nexus-engine-overview"
    },
    {
      "icon": "dashboard",
      "title": "Gateway",
      "type": "link",
      "url": "/d/nexus-gateway"
    },
    {
      "icon": "dashboard",
      "title": "SLO",
      "type": "link",
      "url": "/d/nexus-slo"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Redis",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "title": "Redis Status",
      "type": "stat",
      "targets": [
        { "expr": "up{job=\"redis\"}", "legendFormat": "status" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.70 },
              { "color": "red", "value": 0.85 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "id": 3,
      "title": "Redis Memory Usage",
      "type": "gauge",
      "targets": [
        { "expr": "redis_memory_used_bytes / redis_memory_max_bytes", "legendFormat": "used" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "id": 4,
      "title": "Redis Connected Clients",
      "type": "stat",
      "targets": [
        { "expr": "redis_connected_clients", "legendFormat": "clients" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "id": 5,
      "title": "Redis Hit Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "id": 6,
      "title": "Redis Commands/sec",
      "type": "stat",
      "targets": [
        { "expr": "rate(redis_commands_processed_total[5m])", "legendFormat": "ops/s" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "decbytes"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "id": 7,
      "title": "Redis Memory Over Time",
      "type": "timeseries",
      "targets": [
        { "expr": "redis_memory_used_bytes", "legendFormat": "Used" },
        { "expr": "redis_memory_max_bytes", "legendFormat": "Max" },
        { "expr": "redis_memory_used_bytes - redis_memory_used_rss_bytes", "legendFormat": "Fragmentation" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "id": 8,
      "title": "Redis Keys & Evictions",
      "type": "timeseries",
      "targets": [
        { "expr": "redis_db_keys", "legendFormat": "Total Keys" },
        { "expr": "rate(redis_evicted_keys_total[5m]) * 60", "legendFormat": "Evictions/min" },
        { "expr": "rate(redis_expired_keys_total[5m]) * 60", "legendFormat": "Expired/min" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 20,
      "title": "PostgreSQL",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 13 },
      "id": 21,
      "title": "PostgreSQL Status",
      "type": "stat",
      "targets": [
        { "expr": "up{job=\"postgres\"}", "legendFormat": "status" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.70 },
              { "color": "red", "value": 0.85 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 13 },
      "id": 22,
      "title": "Connection Pool Usage",
      "type": "gauge",
      "targets": [
        { "expr": "pg_stat_activity_count / pg_settings_max_connections", "legendFormat": "used" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 13 },
      "id": 23,
      "title": "Active Connections",
      "type": "stat",
      "targets": [
        { "expr": "pg_stat_activity_count{state=\"active\"}", "legendFormat": "active" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 13 },
      "id": 24,
      "title": "Cache Hit Ratio",
      "type": "stat",
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit{datname=\"nexusqa\"} / (pg_stat_database_blks_hit{datname=\"nexusqa\"} + pg_stat_database_blks_read{datname=\"nexusqa\"})",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1073741824 },
              { "color": "red", "value": 10737418240 }
            ]
          },
          "unit": "decbytes"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 13 },
      "id": 25,
      "title": "Database Size",
      "type": "stat",
      "targets": [
        { "expr": "pg_database_size_bytes{datname=\"nexusqa\"}", "legendFormat": "size" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "id": 26,
      "title": "PostgreSQL Connections Over Time",
      "type": "timeseries",
      "targets": [
        { "expr": "pg_stat_activity_count", "legendFormat": "Total" },
        { "expr": "pg_stat_activity_count{state=\"active\"}", "legendFormat": "Active" },
        { "expr": "pg_stat_activity_count{state=\"idle\"}", "legendFormat": "Idle" },
        { "expr": "pg_settings_max_connections", "legendFormat": "Max" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "id": 27,
      "title": "PostgreSQL Transaction Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname=\"nexusqa\"}[5m])", "legendFormat": "Commits/s" },
        { "expr": "rate(pg_stat_database_xact_rollback{datname=\"nexusqa\"}[5m])", "legendFormat": "Rollbacks/s" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 40,
      "title": "Neo4j",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 25 },
      "id": 41,
      "title": "Neo4j Status",
      "type": "stat",
      "targets": [
        { "expr": "up{job=\"neo4j\"}", "legendFormat": "status" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.70 },
              { "color": "red", "value": 0.85 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 25 },
      "id": 42,
      "title": "Heap Usage",
      "type": "gauge",
      "targets": [
        { "expr": "neo4j_dbms_vm_heap_used / neo4j_dbms_vm_heap_committed", "legendFormat": "heap" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.70 },
              { "color": "red", "value": 0.85 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 25 },
      "id": 43,
      "title": "Page Cache Hit Ratio",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(neo4j_dbms_page_cache_hits_total[5m]) / (rate(neo4j_dbms_page_cache_hits_total[5m]) + rate(neo4j_dbms_page_cache_faults_total[5m]))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 25 },
      "id": 44,
      "title": "Active Transactions",
      "type": "stat",
      "targets": [
        { "expr": "neo4j_transaction_active", "legendFormat": "active" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000000000 },
              { "color": "red", "value": 10000000000 }
            ]
          },
          "unit": "decbytes"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 25 },
      "id": 45,
      "title": "Store Size",
      "type": "stat",
      "targets": [
        { "expr": "neo4j_dbms_store_size_total", "legendFormat": "size" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "decbytes"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 29 },
      "id": 46,
      "title": "Neo4j Memory Over Time",
      "type": "timeseries",
      "targets": [
        { "expr": "neo4j_dbms_vm_heap_used", "legendFormat": "Heap Used" },
        { "expr": "neo4j_dbms_vm_heap_committed", "legendFormat": "Heap Committed" },
        { "expr": "neo4j_dbms_page_cache_bytes", "legendFormat": "Page Cache" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 29 },
      "id": 47,
      "title": "Neo4j Transaction Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(neo4j_transaction_committed_total[5m])", "legendFormat": "Committed/s" },
        { "expr": "rate(neo4j_transaction_rollbacks_total[5m])", "legendFormat": "Rollbacks/s" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 60,
      "title": "Container Resources",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "stacking": { "mode": "none" } },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
      "id": 61,
      "title": "CPU Usage by Pod",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", container!=\"POD\", container!=\"\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "stacking": { "mode": "none" } },
          "unit": "decbytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
      "id": 62,
      "title": "Memory Usage by Pod",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\", container!=\"POD\", container!=\"\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 45 },
      "id": 63,
      "title": "Pod Restarts",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[1h])",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "Bps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 45 },
      "id": 64,
      "title": "Network I/O by Pod",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=~\"$namespace\"}[5m])) by (pod)",
          "legendFormat": "{{pod}} rx"
        },
        {
          "expr": "-sum(rate(container_network_transmit_bytes_total{namespace=~\"$namespace\"}[5m])) by (pod)",
          "legendFormat": "{{pod}} tx"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["nexus-qa", "infrastructure"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": { "selected": false, "text": "nexus-qa", "value": "nexus-qa" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "name": "namespace",
        "query": "label_values(kube_pod_info, namespace)",
        "type": "query",
        "regex": "nexus.*"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Nexus QA — Infrastructure",
  "uid": "nexus-infrastructure",
  "version": 1
}
