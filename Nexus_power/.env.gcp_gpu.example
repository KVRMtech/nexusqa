# ============================================================
# NEXUS QA — GCP GPU spike-test overrides
# ============================================================
# Append these to your .env on the GCP VM after copying from
# .env.example. They flip CPU-bound stages to CUDA and tune the
# canonical pipeline for L4-class hardware (~$0.70/hr).
#
# Usage on the VM:
#   cp .env.example .env
#   # edit .env to set NEXUS_JWT_SECRET, EARS_HF_TOKEN, passwords
#   cat .env.gcp_gpu.example >> .env
#   bash scripts/rebuild_canonical.sh
# ============================================================

# --- GPU enablement (all engines) ---
NEXUS_DEVICE=cuda
NVIDIA_VISIBLE_DEVICES=all

# --- Ears: Whisper + Pyannote on CUDA ---
# float16 is the L4 sweet spot — ~10× CPU throughput at full fidelity.
EARS_WHISPER_DEVICE=cuda
EARS_WHISPER_COMPUTE_TYPE=float16
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
# Pyannote diarization picks the device automatically when NEXUS_DEVICE=cuda.
EARS_DIARIZATION_INFERENCE_TIMEOUT_SECONDS=120
EARS_SKIP_DIARIZATION_FAST=false

# --- Eyes: OCR + Vision on CUDA ---
VISION_DEVICE=cuda
EYES_OCR_GPU=true
# L4 handles 4 concurrent EasyOCR threads comfortably (vs 2 on CPU/WSL2).
EYES_OCR_MAX_WORKERS=4
# Enable per-frame LLaVA on multi-frame scenes — cheap on GPU, valuable
# for step-level evidence. Set false if you want minimum cost.
EYES_PER_FRAME_LLAVA=true
EYES_PER_FRAME_LLAVA_LIMIT=60
# Per-frame OCR — also cheap on GPU. Keep false for the first spike;
# flip true once you've benchmarked the baseline.
EYES_PER_FRAME_OCR=false
# Don't downscale on GPU — fidelity over throughput when OCR is cheap.
EYES_OCR_DOWNSCALE_MAX_WIDTH=0
# Run more chunks concurrently when GPU has headroom.
EYES_CHUNK_CONCURRENCY=2

# --- Heart / Brain: local LLM on CUDA when running Ollama on the VM ---
# If you want a fully self-contained spike, Ollama on the same VM runs
# llama3.2 on the L4. For cleaner separation, use the tier-1/2 cloud
# providers — see below.
HEART_LLM_DEVICE=cuda

# --- LLM tiering (recommended for spike — skip self-hosted Ollama) ---
# Spike-test path: point heart + eyes + brain at Anthropic or OpenAI so
# you don't burn VM RAM on Ollama. Tear-down stays simple.
#
# EYES_VISION_TIER1_PROVIDER=anthropic
# EYES_VISION_TIER1_MODEL=claude-sonnet-4-6
# EYES_VISION_TIER1_API_KEY=sk-ant-...
# EYES_VISION_TIER1_TIMEOUT=120
#
# HEART_TIER1_PROVIDER=anthropic
# HEART_TIER1_MODEL=claude-sonnet-4-6
# HEART_TIER1_API_KEY=sk-ant-...
#
# BRAIN_TIER1_PROVIDER=anthropic
# BRAIN_TIER1_MODEL=claude-sonnet-4-6
# BRAIN_TIER1_API_KEY=sk-ant-...

# --- Canonical pipeline budget knobs (GPU-tuned) ---
# Each value below is an override for what's hard-coded in
# nexus_sdk.workflows.plans. On GPU, OCR/LLaVA finish so fast that
# the conservative laptop deadlines are wasteful — these reflect
# realistic GPU wall times.
#
# (These are READ at plan-construction time inside the orchestrator;
# they only take effect if the orchestrator was built to honor them.
# Right now the plan factory uses constants — to override per-deploy
# without code changes, prefer keeping the laptop defaults and letting
# the workflow finish well under the deadline.)

# --- Orchestrator-side tuning ---
ORCHESTRATOR_DEFAULT_PROCESSING_PROFILE=multimodal
MAX_CONCURRENT_WORKFLOWS_PER_TENANT=20

# --- Redis Streams reclaim — GPU is fast, drop the threshold ---
# Default in SDK is 30 min (set high for CPU OCR). On GPU, OCR finishes
# in under 2 min, so a tighter reclaim catches genuinely dead workers
# faster without false-positives. Wire this in via the engine's
# JobQueueConfig override if you want it explicit.
#
# NEXUS_QUEUE_CLAIM_IDLE_MS=600000   # 10 min

# --- Storage paths (GCP-native; map to a persistent disk in prod) ---
NEXUS_STORAGE_PATH=/data/nexus
NEXUS_AUDIO_STORAGE_PATH=/data/nexus/audio
NEXUS_SCREENSHOTS_PATH=/data/nexus/screenshots
NEXUS_MODELS_PATH=/models
