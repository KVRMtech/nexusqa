"""
Nexus Platform API — Cross-cutting backend for all UI module pages.

Handles routes that span multiple engines:
  /api/v1/sessions/*         — Knowledge capture session management
  /api/v1/sme/*              — SME profile aggregation
  /api/v1/contradictions/*   — Contradiction tracking & resolution
  /api/v1/guardrails/*       — AI confidence pipeline & review queue
  /api/v1/traceability/*     — Living traceability matrix
  /api/v1/tests/*            — Test suite & run management
  /api/v1/data-forge/*       — Test data config & results
  /api/v1/compliance/*       — Jurisdiction compliance tracking
  /api/v1/insights/*         — Executive KPIs, ROI, risks, trends
  /api/v1/admin/*            — Engine grid, resources, integrations, audit, users

Port: 8090
"""
from __future__ import annotations

import os
import uuid
import time
import asyncio
import logging
from datetime import datetime, timezone, timedelta
from typing import Optional

import httpx
import structlog
from contextlib import asynccontextmanager
from fastapi import FastAPI, Request, Query, Path, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field
from pydantic_settings import BaseSettings

logger = structlog.get_logger()


# ─── Configuration ─────────────────────────────────────────────

class PlatformAPIConfig(BaseSettings):
    host: str = "0.0.0.0"
    port: int = 8091

    # Engine URLs (for aggregation)
    auth_service_url: str = "http://localhost:8000"
    shield_engine_url: str = "http://localhost:8001"
    ears_engine_url: str = "http://localhost:8002"
    eyes_engine_url: str = "http://localhost:8003"
    heart_engine_url: str = "http://localhost:8004"
    backbone_engine_url: str = "http://localhost:8005"
    nerves_engine_url: str = "http://localhost:8006"
    legs_engine_url: str = "http://localhost:8007"
    hands_engine_url: str = "http://localhost:8008"
    spine_engine_url: str = "http://localhost:8009"
    mouth_engine_url: str = "http://localhost:8010"

    # Database
    database_url: str = "postgresql://nexus:nexus-dev@localhost:5432/nexus"
    redis_url: str = "redis://localhost:6379/0"

    model_config = {"env_file": ".env", "extra": "ignore"}


config = PlatformAPIConfig()


@asynccontextmanager
async def lifespan(application: FastAPI):
    _seed_data()
    logger.info("platform_api.started", routes=28, port=config.port)
    yield
    await _http.aclose()
    logger.info("platform_api.stopped")


app = FastAPI(
    title="Nexus Platform API",
    description="Cross-cutting API for all UI module pages",
    version="0.1.0",
    lifespan=lifespan,
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=False,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Async HTTP client for engine calls
_http = httpx.AsyncClient(timeout=30.0)


# ─── In-Memory Stores (production: backed by PostgreSQL) ───────
# These stores are populated on startup and updated via API / events.

_sessions: dict[str, dict] = {}
_sme_profiles: dict[str, dict] = {}
_contradictions: dict[str, dict] = {}
_guardrail_pipeline: list[dict] = []
_review_queue: list[dict] = []
_trust_trend: list[dict] = []
_traces: list[dict] = []
_test_suites: list[dict] = []
_test_runs: list[dict] = []
_forge_configs: list[dict] = []
_forge_results: list[dict] = []
_jurisdictions: list[dict] = []
_audit_log: list[dict] = []

# ─── Seed Data ─────────────────────────────────────────────────
# Production mode: stores start empty. Data is created through the UI / API.

def _seed_data():
    """Initialize empty stores for a clean production start."""
    pass  # All stores are already initialized as empty dicts/lists above


# ─── Startup ──────────────────────────────────────────────────

# Startup/shutdown handled via lifespan context manager above


# ─── Health ───────────────────────────────────────────────────

@app.get("/health")
async def health():
    return {"status": "healthy", "service": "nexus-platform-api", "routes": 28}


# ═══════════════════════════════════════════════════════════════
#  SESSIONS (Module 1 & 2)
# ═══════════════════════════════════════════════════════════════

@app.get("/api/v1/sessions")
async def list_sessions(tenant_id: str = Query("t-1")):
    """List all knowledge capture sessions for a tenant."""
    sessions = [s for s in _sessions.values() if s.get("tenant_id") == tenant_id]
    # Strip large nested data for list view
    return [
        {k: v for k, v in s.items() if k not in ("events", "transcript")}
        for s in sessions
    ]


@app.get("/api/v1/sessions/{session_id}")
async def get_session(session_id: str = Path(...)):
    """Get a single session with full detail."""
    session = _sessions.get(session_id)
    if not session:
        raise HTTPException(404, f"Session {session_id} not found")
    return {k: v for k, v in session.items() if k not in ("events", "transcript")}


@app.get("/api/v1/sessions/{session_id}/events")
async def get_session_events(session_id: str = Path(...)):
    """Get intelligence events timeline for a session."""
    session = _sessions.get(session_id)
    if not session:
        raise HTTPException(404, f"Session {session_id} not found")
    return session.get("events", [])


@app.get("/api/v1/sessions/{session_id}/transcript")
async def get_session_transcript(session_id: str = Path(...)):
    """Get transcript segments for a session."""
    session = _sessions.get(session_id)
    if not session:
        raise HTTPException(404, f"Session {session_id} not found")
    return session.get("transcript", [])


