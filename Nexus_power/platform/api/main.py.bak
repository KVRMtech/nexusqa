@app.get("/api/v1/contradictions")
async def list_contradictions(tenant_id: str = Query("t-1")):
    """List all detected contradictions."""
    return list(_contradictions.values())


class ResolveRequest(BaseModel):
    resolution: str


@app.post("/api/v1/contradictions/{contradiction_id}/resolve")
async def resolve_contradiction(
    contradiction_id: str = Path(...),
    body: ResolveRequest = ...,
):
    """Resolve a contradiction with a resolution statement."""
    c = _contradictions.get(contradiction_id)
    if not c:
        raise HTTPException(404, f"Contradiction {contradiction_id} not found")
    c["status"] = "resolved"
    c["resolution"] = body.resolution
    c["resolved_at"] = datetime.now(timezone.utc).isoformat()
    _audit_log.insert(0, {
        "id": f"al-{uuid.uuid4().hex[:6]}",
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "user": "current_user",
        "action": "CONTRADICTION_RESOLVED",
        "resource": contradiction_id,
        "details": f"Resolved: {body.resolution[:80]}",
    })
    return c


