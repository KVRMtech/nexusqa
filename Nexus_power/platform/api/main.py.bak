@app.get("/api/v1/admin/engines")
async def get_admin_engines():
    """Get detailed engine info for admin panel — queries each engine's health endpoint."""
    engine_defs = [
        ("Ears", "Speech-to-Text", config.ears_engine_url),
        ("Eyes", "Screen Capture", config.eyes_engine_url),
        ("Heart", "LLM / AI Core", config.heart_engine_url),
        ("Backbone", "Knowledge Graph", config.backbone_engine_url),
        ("Shield", "Auth & Security", config.shield_engine_url),
        ("Nerves", "Connectors", config.nerves_engine_url),
        ("Hands", "Test Generator", config.hands_engine_url),
        ("Legs", "Test Executor", config.legs_engine_url),
        ("Spine", "Orchestrator", config.spine_engine_url),
        ("Mouth", "Report Generator", config.mouth_engine_url),
    ]
    engines = []
    for name, code_name, url in engine_defs:
        entry = {
            "name": name, "codeName": code_name,
            "status": "offline", "mode": "stub",
            "uptime": "unknown", "version": "0.1.0",
            "cpu": 0, "memory": 0, "requests24h": 0, "errors24h": 0,
        }
        try:
            resp = await _http.get(f"{url}/health/detail", timeout=3.0)
            if resp.status_code == 200:
                data = resp.json()
                entry["status"] = "online" if data.get("status") == "healthy" else "degraded"
                modes = data.get("modes", {})
                # If any mode is not stub, consider it "real"
                entry["mode"] = "real" if any(v != "stub" for v in modes.values()) else "stub"
                entry["uptime"] = data.get("uptime", "unknown")
                entry["version"] = data.get("version", "0.1.0")
        except Exception:
            pass
        engines.append(entry)
    return engines


@app.get("/api/v1/admin/resources")
async def get_admin_resources():
    """Get system resource usage."""
    import psutil
    cpu_percent = psutil.cpu_percent(interval=0.1) if "psutil" in dir() else 0
    mem = psutil.virtual_memory() if "psutil" in dir() else None
    try:
        import psutil as _ps
        cpu_percent = _ps.cpu_percent(interval=0.1)
        mem = _ps.virtual_memory()
        disk = _ps.disk_usage("/")
        return {
            "gpu": {"label": "GPU (CUDA)", "used": 0, "total": 0, "unit": "GB"},
            "ram": {"label": "System RAM", "used": round(mem.used / 1e9, 1), "total": round(mem.total / 1e9, 1), "unit": "GB"},
            "cpu": {"label": "CPU Cores", "used": round(cpu_percent), "total": 100, "unit": "%"},
            "storage": {"label": "Storage", "used": round(disk.used / 1e9, 1), "total": round(disk.total / 1e9, 1), "unit": "GB"},
        }
    except ImportError:
        return {
            "gpu": {"label": "GPU (CUDA)", "used": 0, "total": 0, "unit": "GB"},
            "ram": {"label": "System RAM", "used": 4.8, "total": 7.6, "unit": "GB"},
            "cpu": {"label": "CPU Cores", "used": 35, "total": 100, "unit": "%"},
            "storage": {"label": "Storage", "used": 120, "total": 500, "unit": "GB"},
        }


@app.get("/api/v1/admin/integrations")
async def get_admin_integrations(tenant_id: str = Query("t-1")):
    """List configured integrations and their connection status."""
    # Check real connectors via Nerves engine
    integrations = []
    try:
        resp = await _http.get(f"{config.nerves_engine_url}/api/v1/nerves/connectors", timeout=5.0)
        if resp.status_code == 200:
            connectors = resp.json()
            for c in connectors.get("connectors", connectors) if isinstance(connectors, dict) else connectors:
                name = c.get("name", c) if isinstance(c, dict) else c
                integrations.append({
                    "name": name,
                    "type": c.get("type", "Connector") if isinstance(c, dict) else "Connector",
                    "status": "connected" if c.get("configured") else "disconnected" if isinstance(c, dict) else "disconnected",
                    "lastSync": c.get("last_sync", "Never") if isinstance(c, dict) else "Never",
                })
    except Exception:
        pass

    # If no real connectors, return defaults
    if not integrations:
        integrations = [
            {"name": "Jira Cloud", "type": "Issue Tracker", "status": "disconnected", "lastSync": "Never"},
            {"name": "GitHub", "type": "Source Control", "status": "disconnected", "lastSync": "Never"},
            {"name": "Slack", "type": "Messaging", "status": "disconnected", "lastSync": "Never"},
        ]
    return integrations


