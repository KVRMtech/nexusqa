"""
Nexus API Gateway — Reverse proxy that routes requests to the correct engine.

Routes:
  /api/v1/auth/*            → Auth Service (port 8000)
  /api/v1/shield/*          → Shield Engine (port 8001)
  /api/v1/ears/*            → Ears Engine (port 8002)
  /api/v1/eyes/*            → Eyes Engine (port 8003)
  /api/v1/heart/*           → Heart Engine (port 8004)
  /api/v1/backbone/*        → Backbone Engine (port 8005)
  /api/v1/nerves/*          → Nerves Engine (port 8006)
  /api/v1/legs/*            → Legs Engine (port 8007)
  /api/v1/hands/*           → Hands Engine (port 8008)
  /api/v1/spine/*           → Spine Engine (port 8009)
  /api/v1/mouth/*           → Mouth Engine (port 8010)
  /api/v1/orchestrator/*    → Orchestrator (port 8100)
  /api/v1/sessions/*        → Platform API (port 8091)
  /api/v1/sme/*             → Platform API (port 8091)
  /api/v1/contradictions/*  → Platform API (port 8091)
  /api/v1/guardrails/*      → Platform API (port 8091)
  /api/v1/traceability/*    → Platform API (port 8091)
  /api/v1/tests/*           → Platform API (port 8091)
  /api/v1/data-forge/*      → Platform API (port 8091)
  /api/v1/compliance/*      → Platform API (port 8091)
  /api/v1/insights/*        → Platform API (port 8091)
  /api/v1/admin/*           → Platform API (port 8091)

Also provides:
  - Rate limiting per tenant
  - Request logging
  - Usage metering
  - JWT validation at the edge
"""

from __future__ import annotations

import time
import threading
from collections import defaultdict
import httpx
import structlog
from fastapi import FastAPI, Request, Response, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from pydantic_settings import BaseSettings
from pydantic import Field

logger = structlog.get_logger()


class GatewayConfig(BaseSettings):
    gateway_port: int = Field(default=8080, description="Gateway listen port")
    cors_allowed_origins: str = Field(
        default="*",
        description="Comma-separated allowed CORS origins",
    )
    rate_limit_per_minute: int = Field(
        default=600,
        description="Max requests per tenant per minute (0=unlimited)",
    )
    # JWT validation at edge
    nexus_jwt_secret: str = Field(
        default="dev-jwt-secret-key-change-in-production",
        description="JWT signing secret — must match auth service",
    )
    jwt_algorithm: str = Field(default="HS256")
    # Public paths that don't require auth
    public_path_prefixes: str = Field(
        default="/api/v1/auth/login,/api/v1/auth/tenants",
        description="Comma-separated path prefixes that skip JWT validation",
    )
    auth_service_url: str = Field(default="http://auth-service:8000")
    shield_engine_url: str = Field(default="http://shield-engine:8001")
    ears_engine_url: str = Field(default="http://ears-engine:8002")
    eyes_engine_url: str = Field(default="http://eyes-engine:8003")
    heart_engine_url: str = Field(default="http://heart-engine:8004")
    backbone_engine_url: str = Field(default="http://backbone-engine:8005")
    nerves_engine_url: str = Field(default="http://nerves-engine:8006")
    legs_engine_url: str = Field(default="http://legs-engine:8007")
    hands_engine_url: str = Field(default="http://hands-engine:8008")
    spine_engine_url: str = Field(default="http://spine-engine:8009")
    mouth_engine_url: str = Field(default="http://mouth-engine:8010")
    orchestrator_url: str = Field(default="http://orchestrator:8100")
    platform_api_url: str = Field(default="http://platform-api:8091")

    model_config = {"env_file": ".env", "extra": "ignore"}


config = GatewayConfig()

# Route table: path prefix → upstream URL
ROUTES = {
    "/api/v1/auth": config.auth_service_url,
    "/api/v1/shield": config.shield_engine_url,
    "/api/v1/ears": config.ears_engine_url,
    "/api/v1/eyes": config.eyes_engine_url,
    "/api/v1/heart": config.heart_engine_url,
    "/api/v1/backbone": config.backbone_engine_url,
    "/api/v1/nerves": config.nerves_engine_url,
    "/api/v1/legs": config.legs_engine_url,
    "/api/v1/hands": config.hands_engine_url,
    "/api/v1/spine": config.spine_engine_url,
    "/api/v1/mouth": config.mouth_engine_url,
    # Orchestrator
    "/api/v1/orchestrator": config.orchestrator_url,
    # Platform API — cross-cutting UI backend routes
    "/api/v1/sessions": config.platform_api_url,
    "/api/v1/sme": config.platform_api_url,
    "/api/v1/contradictions": config.platform_api_url,
    "/api/v1/guardrails": config.platform_api_url,
    "/api/v1/traceability": config.platform_api_url,
    "/api/v1/tests": config.platform_api_url,
    "/api/v1/data-forge": config.platform_api_url,
    "/api/v1/compliance": config.platform_api_url,
    "/api/v1/insights": config.platform_api_url,
    "/api/v1/admin": config.platform_api_url,
}

app = FastAPI(
    title="Nexus QA API Gateway",
    description="Central entry point for all Nexus engines",
    version="0.1.0",
)

# CORS — restricted via CORS_ALLOWED_ORIGINS env var
_origins = [o.strip() for o in config.cors_allowed_origins.split(",") if o.strip()]
app.add_middleware(
    CORSMiddleware,
    allow_origins=_origins,
    allow_credentials=True if "*" not in _origins else False,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Async HTTP client for proxying
_client = httpx.AsyncClient(timeout=300.0)  # 5 min timeout for long operations


# ─── Per-Tenant Rate Limiter ──────────────────────────────────

class _RateLimiter:
    """Sliding-window rate limiter (per tenant, per minute)."""

    def __init__(self, max_per_minute: int):
        self.max_per_minute = max_per_minute
        self._buckets: dict[str, list[float]] = defaultdict(list)
        self._lock = threading.Lock()

    def allow(self, tenant_id: str) -> bool:
        if self.max_per_minute <= 0:
            return True
        now = time.monotonic()
        cutoff = now - 60.0
        with self._lock:
            bucket = self._buckets[tenant_id]
            # Prune old entries
            self._buckets[tenant_id] = [t for t in bucket if t > cutoff]
            if len(self._buckets[tenant_id]) >= self.max_per_minute:
                return False
            self._buckets[tenant_id].append(now)
            return True


_rate_limiter = _RateLimiter(config.rate_limit_per_minute)


@app.get("/")
async def root():
    return {
        "service": "nexus-gateway",
        "version": "0.1.0",
        "engines": list(ROUTES.keys()),
        "docs": "/docs",
    }


@app.get("/health")
async def health():
    """Gateway health check."""
    return {"status": "healthy", "service": "nexus-gateway"}


@app.get("/api/v1/engines/status")
async def engine_status():
    """Check health of all backend engines."""
    statuses = {}
    for prefix, url in ROUTES.items():
        engine_name = prefix.split("/")[-1]
        try:
            resp = await _client.get(f"{url}/health", timeout=5.0)
            statuses[engine_name] = resp.json()
        except Exception as e:
            statuses[engine_name] = {"status": "unreachable", "error": str(e)}
    return statuses


@app.api_route(
    "/api/v1/{path:path}",
    methods=["GET", "POST", "PUT", "DELETE", "PATCH"],
)
async def proxy(request: Request, path: str):
    """
    Reverse proxy — routes requests to the correct engine.
    """
    full_path = f"/api/v1/{path}"

    # ── Public paths skip auth ──────────────────────────────
    _public_prefixes = [p.strip() for p in config.public_path_prefixes.split(",") if p.strip()]
    is_public = any(full_path.startswith(p) for p in _public_prefixes)

    # ── JWT validation at the edge ──────────────────────────
    tenant_id = "anonymous"
    auth_header = request.headers.get("authorization", "")
    if auth_header.startswith("Bearer "):
        try:
            import jwt as _jwt
            payload = _jwt.decode(
                auth_header[7:],
                config.nexus_jwt_secret,
                algorithms=[config.jwt_algorithm],
            )
            tenant_id = payload.get("tenant_id", "anonymous")
        except Exception as e:
            if not is_public:
                logger.warning("gateway.jwt_invalid", error=str(e), path=full_path)
                raise HTTPException(
                    status_code=401,
                    detail="Invalid or expired authentication token",
                )
    elif not is_public:
        # No token on a protected route — allow for now with warning
        # (strict mode would reject here)
        logger.debug("gateway.no_auth_token", path=full_path)
    if not _rate_limiter.allow(tenant_id):
        raise HTTPException(
            status_code=429,
            detail="Rate limit exceeded. Try again shortly.",
        )

    # Find the matching upstream
    upstream_url = None
    for prefix, url in ROUTES.items():
        if full_path.startswith(prefix):
            upstream_url = url
            break

    if not upstream_url:
        raise HTTPException(status_code=404, detail=f"No engine handles path: {full_path}")

    # Build upstream request — strip the gateway prefix so engine sees its own routes
    # e.g. /api/v1/ears/health/ready → /health/ready  (engine health routes have no /api/v1 prefix)
    for prefix in ROUTES:
        if full_path.startswith(prefix):
            suffix = full_path[len(prefix):]  # e.g. "/health/ready"
            if suffix.startswith("/health"):
                # Health routes are mounted at root on engines
                target_url = f"{upstream_url}{suffix}"
            else:
                target_url = f"{upstream_url}{full_path}"
            break
    else:
        target_url = f"{upstream_url}{full_path}"
    
    start = time.monotonic()

    try:
        # Forward the request
        body = await request.body()
        headers = dict(request.headers)
        headers.pop("host", None)  # Don't forward the host header

        resp = await _client.request(
            method=request.method,
            url=target_url,
            content=body,
            headers=headers,
            params=dict(request.query_params),
        )

        elapsed_ms = (time.monotonic() - start) * 1000

        logger.info(
            "gateway.proxy",
            method=request.method,
            path=full_path,
            upstream=upstream_url,
            status=resp.status_code,
            duration_ms=round(elapsed_ms, 2),
        )

        return Response(
            content=resp.content,
            status_code=resp.status_code,
            headers=dict(resp.headers),
        )

    except httpx.ConnectError:
        engine_name = full_path.split("/")[3] if len(full_path.split("/")) > 3 else "unknown"
        raise HTTPException(
            status_code=503,
            detail=f"Engine '{engine_name}' is not available. Is it running?",
        )
    except httpx.TimeoutException:
        raise HTTPException(
            status_code=504,
            detail="Engine request timed out",
        )


# ─── Entry Point ──────────────────────────────────────────────

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=config.gateway_port, log_level="info")
