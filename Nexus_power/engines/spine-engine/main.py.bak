"""
Nexus Spine Engine — Document Ingestion & Knowledge Extraction.

The spine that reads and structures all written knowledge.
60% of insurance knowledge lives in DOCUMENTS, not conversations:

- PDF rate filings (state-approved premium tables)
- Excel rate tables (age × gender × tobacco × class → premium)
- Word BRDs (Business Requirements Documents)
- PowerPoint training decks (onboarding / KT materials)
- CSV data imports (policy admin extracts, claim files)
- Compliance manuals, underwriting guidelines, procedure docs

The Spine Engine:
1. Parses documents into structured chunks (pages, sections, tables)
2. Extracts tables with full structure preservation
3. Classifies document type (rate filing, BRD, training, compliance)
4. Chunks text for embedding + vector storage (Backbone)
5. Feeds extracted knowledge to Heart for rule extraction
6. Maintains full provenance (page number, section, paragraph)

Every piece of extracted knowledge carries its source reference.
"""

from __future__ import annotations

import os
import io
import uuid
import time
import hashlib
import tempfile
from datetime import datetime, timezone
from typing import Optional, Any
from enum import Enum
from pathlib import Path

from fastapi import Depends, HTTPException, BackgroundTasks, UploadFile, File, Form
from pydantic import BaseModel, Field

from nexus_sdk import NexusEngine, EngineConfig
from nexus_sdk.models import (
    NexusRequest, NexusResponse, JobResponse, JobStatus,
    SourceReference, Confidence,
)
from nexus_sdk.auth import NexusUser, get_current_user
from nexus_sdk.events import NexusEvent, fire_stub_alert

# Module-level event bus reference for static parser stubs
_spine_event_bus = None
_spine_stub_counts: dict[str, int] = {}


# ─── Configuration ─────────────────────────────────────────────

class SpineConfig(EngineConfig):
    engine_name: str = "spine"
    engine_port: int = 8009

    # Document storage
    document_storage_path: str = "/data/nexus/documents"

    # Chunking
    chunk_size: int = 1000          # characters per chunk
    chunk_overlap: int = 200        # overlap between chunks
    max_document_size_mb: int = 100  # max upload size

    # Table extraction
    table_extraction_enabled: bool = True

    # OCR for scanned PDFs
    ocr_enabled: bool = True
    ocr_language: str = "eng"

    # Supported formats
    supported_formats: str = "pdf,xlsx,xls,docx,doc,pptx,ppt,csv,txt,md"


# ─── Enums ────────────────────────────────────────────────────

class DocumentType(str, Enum):
    """Insurance document classifications."""
    RATE_FILING = "rate_filing"
    RATE_TABLE = "rate_table"
    BRD = "business_requirements_document"
    TRAINING_DECK = "training_deck"
    COMPLIANCE_MANUAL = "compliance_manual"
    UNDERWRITING_GUIDE = "underwriting_guide"
    PROCEDURE_DOCUMENT = "procedure_document"
    POLICY_FORM = "policy_form"
    APPLICATION_FORM = "application_form"
    CLAIM_FORM = "claim_form"
    ACTUARIAL_MEMO = "actuarial_memo"
    STATE_APPROVAL = "state_approval"
    GENERAL = "general"
    UNKNOWN = "unknown"


class ChunkType(str, Enum):
    TEXT = "text"
    TABLE = "table"
    HEADING = "heading"
    LIST = "list"
    IMAGE_CAPTION = "image_caption"
    METADATA = "metadata"


class ParseStatus(str, Enum):
    PENDING = "pending"
    PARSING = "parsing"
    CHUNKING = "chunking"
    CLASSIFYING = "classifying"
    STORING = "storing"
    COMPLETED = "completed"
    FAILED = "failed"


