# ============================================================
# NEXUS QA — Environment Configuration
# ============================================================
# Copy this file to .env and edit with your settings.
# All engines read from this shared configuration.
# ============================================================

# --- Platform ---
NEXUS_ENV=production
NEXUS_LOG_LEVEL=INFO
NEXUS_SECRET_KEY=change-this-to-a-random-64-char-string
NEXUS_API_PORT=8000
PLATFORM_API_URL=http://localhost:8000

# --- Authentication ---
NEXUS_JWT_SECRET=change-this-to-a-random-secret
NEXUS_JWT_EXPIRY_HOURS=24
NEXUS_ADMIN_EMAIL=admin@nexus.local
NEXUS_ADMIN_PASSWORD=change-this-password

# --- Redis (Message Bus + Cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password

# --- Neo4j (Knowledge Graph) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-neo4j-password

# --- Milvus (Vector Store) ---
MILVUS_HOST=milvus
MILVUS_PORT=19530

# --- PostgreSQL (Metadata, Auth, Tenants) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-this-postgres-password

# --- Shield Engine ---
SHIELD_PORT=8001
SHIELD_PII_CONFIDENCE_THRESHOLD=0.85
SHIELD_CUSTOM_PATTERNS_PATH=/app/config/pii_patterns.yaml
SHIELD_ENCRYPTION_KEY=  # Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SHIELD_MAPPING_TTL_SECONDS=2592000  # 30 days

# --- Ears Engine ---
EARS_PORT=8002
EARS_WHISPER_MODEL=large-v3
EARS_WHISPER_DEVICE=cuda
EARS_WHISPER_COMPUTE_TYPE=float16
EARS_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
EARS_HF_TOKEN=your-huggingface-token-here

# --- Eyes Engine ---
EYES_PORT=8003
EYES_OLLAMA_BASE_URL=http://ollama:11434
EYES_OLLAMA_MODEL=llama3.2-vision:11b
EYES_FRAME_DIFF_THRESHOLD=0.15
EYES_CAPTURE_INTERVAL_SECONDS=10
# Per-frame LLaVA — gives each frame in a multi-frame scene its own
# description so the step extractor can detect intra-page actions.
# Cost: up to ~50 extra LLaVA calls per artifact.  Keep OFF for
# CPU-only Ollama; flip ON for GPU or any cloud Tier-1 provider.
EYES_PER_FRAME_LLAVA=false
EYES_PER_FRAME_LLAVA_LIMIT=60
# Per-frame OCR — runs EasyOCR on every frame inside scenes with ≥3
# frames.  Cost: ~30-60s/frame on CPU EasyOCR; trivial on GPU.
EYES_PER_FRAME_OCR=false
# OCR languages — comma-separated EasyOCR codes (e.g. "en,es,fr,de").
EYES_OCR_LANGUAGES=en
# Memory ceiling (MiB) — eyes drops interim buffers when RSS exceeds.
# Set to 0 to disable; raise on hosts with abundant RAM.
EYES_MEMORY_CEILING_MB=2048
EYES_AGGRESSIVE_FRAME_EVICTION=true
#
# ── Long-video chunking + checkpoint resume (Phase 2) ───────────────────
# Videos longer than this many seconds are split into fixed-duration
# chunks via ffmpeg before processing.  Each chunk's result is written
# to {chunk_dir}/chunk_NNN_result.json — on a crash the next run loads
# completed chunks and skips them so a 3-hour demo doesn't lose an
# hour of work to a pod restart.
EYES_CHUNK_THRESHOLD_SECONDS=600
EYES_CHUNK_DURATION_SECONDS=300
# How many chunks may run their full pipeline concurrently.  Raised
# from 1 to 2 in Phase 2 — CPU stages of one chunk overlap with
# another's GPU wait, cutting wall time ~30%.  Raise to 3-4 on
# multi-GPU hosts.
EYES_CHUNK_CONCURRENCY=2
# Downscale frames wider than this before OCR.  Raised from 0
# (disabled) to 1600 in Phase 2 — keeps small text >=0.83 px/source
# pixel on 1080p captures, well above the OCR-hallucination floor.
# Set to 0 for fidelity-critical recordings.
EYES_OCR_DOWNSCALE_MAX_WIDTH=1600
#
# ── Distributed Ollama pool (Phase 2) ───────────────────────────────────
# Comma-separated failover endpoints in addition to the primary
# EYES_OLLAMA_BASE_URL.  When unset, single-endpoint operation.
# EYES_OLLAMA_FAILOVER_URLS=http://ollama-2:11434,http://ollama-3:11434
#
# When true, the active client index advances after every successful
# call (round-robin), so a long demo distributes LLaVA invocations
# across all configured endpoints.  When false (default), the index
# only moves on failover — preserving sticky-primary behaviour.
EYES_OLLAMA_LOAD_BALANCE=false
#
# ── Vision Tier Router (Tier 1 / 2 / 3) ─────────────────────────────────
# Set ANY EYES_VISION_TIER{1,2,3}_PROVIDER to enable the tier router.
# When enabled, eyes-engine routes through nexus_sdk.vision instead of
# the legacy direct-Ollama call.  Tiers fall back 1 → 2 → 3 on retriable
# errors; non-retriable errors poison a tier for the rest of the process.
# Leave all unset to keep the legacy single-Ollama path.
#
# Tier 1 example — Anthropic Claude vision (recommended for production)
# EYES_VISION_TIER1_PROVIDER=anthropic
# EYES_VISION_TIER1_MODEL=claude-sonnet-4-6
# EYES_VISION_TIER1_API_KEY=sk-ant-...
# EYES_VISION_TIER1_TIMEOUT=120
# EYES_VISION_TIER1_RETRIES=1
#
# Tier 2 example — OpenAI gpt-4o (multi-region fallback)
# EYES_VISION_TIER2_PROVIDER=openai
# EYES_VISION_TIER2_MODEL=gpt-4o
# EYES_VISION_TIER2_API_KEY=sk-...
# EYES_VISION_TIER2_TIMEOUT=120
# EYES_VISION_TIER2_RETRIES=1
#
# Tier 3 example — local Ollama (on-prem backup, GPU recommended)
# EYES_VISION_TIER3_PROVIDER=ollama
# EYES_VISION_TIER3_MODEL=llama3.2-vision:11b
# EYES_VISION_TIER3_BASE_URL=http://ollama:11434
# EYES_VISION_TIER3_TIMEOUT=180
# EYES_VISION_TIER3_RETRIES=1
# EYES_VISION_TIER_ORDER=1,2,3

# --- Heart Engine ---
HEART_PORT=8004
HEART_ENGINE_URL=http://localhost:8004
HEART_OLLAMA_BASE_URL=http://ollama:11434
HEART_OLLAMA_MODEL=llama3.2:1b
HEART_TIER3_PROVIDER=ollama
HEART_TIER3_OLLAMA_BASE_URL=http://ollama:11434
HEART_TIER3_MODEL=llama3.2:1b
# HEART_TIER1_PROVIDER=azure
# HEART_TIER1_MODEL=gpt-4o
# HEART_TIER1_API_KEY=
# HEART_TIER1_AZURE_ENDPOINT=https://<resource>.openai.azure.com
# HEART_TIER1_AZURE_DEPLOYMENT=gpt-4o
# HEART_TIER2_PROVIDER=openai
# HEART_TIER2_MODEL=gpt-4o
# HEART_TIER2_API_KEY=
HEART_LLM_MODEL_PATH=/models/llama-3.1-70b-q4
HEART_LLM_DEVICE=cuda
HEART_LLM_CONTEXT_LENGTH=8192
HEART_CONFIDENCE_THRESHOLD=0.80
HEART_REQUIRE_HUMAN_REVIEW=true

# --- Backbone Engine ---
BACKBONE_PORT=8005
BACKBONE_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# --- Nerves Engine ---
NERVES_PORT=8006

# --- Legs Engine ---
LEGS_PORT=8007
LEGS_MAX_PARALLEL_EXECUTIONS=20
LEGS_BROWSER_HEADLESS=true
LEGS_SCREENSHOT_ON_FAILURE=true
LEGS_SCREENSHOT_ON_SUCCESS=false

# --- Hands Engine (Test Data Generation) ---
HANDS_PORT=8008
HANDS_MAX_RECORDS_PER_REQUEST=10000
HANDS_MAX_COMBINATIONS=50000
HANDS_DEFAULT_BATCH_SIZE=500

# --- Spine Engine (Document Ingestion) ---
SPINE_PORT=8009
SPINE_MAX_FILE_SIZE_MB=100
SPINE_SUPPORTED_FORMATS=pdf,xlsx,xls,docx,pptx,csv,txt
SPINE_STORAGE_PATH=/data/nexus/documents

# --- Mouth Engine (Reporting) ---
MOUTH_PORT=8010
MOUTH_PDF_ENGINE=weasyprint
MOUTH_MAX_REPORT_PAGES=500
MOUTH_INCLUDE_EVIDENCE_SCREENSHOTS=true
MOUTH_REPORT_RETENTION_DAYS=365
MOUTH_REPORT_STORAGE_PATH=/data/nexus/reports

# --- Brain Engine (Intelligent Coordinator) ---
BRAIN_PORT=8011
BRAIN_OLLAMA_BASE_URL=http://ollama:11434
BRAIN_OLLAMA_MODEL=llama3.2:1b
BRAIN_TIER3_PROVIDER=ollama
BRAIN_TIER3_OLLAMA_BASE_URL=http://ollama:11434
BRAIN_TIER3_MODEL=llama3.2:1b
BRAIN_TIER3_TIMEOUT=780
BRAIN_TIER3_MAX_RETRIES=1
# Brain coordinates across all engines — see .env.tiers.example for tier config
# BRAIN_TIER1_PROVIDER=anthropic
# BRAIN_TIER1_MODEL=claude-opus-4-20250514
# BRAIN_TIER1_API_KEY=
# BRAIN_TIER2_PROVIDER=openai
# BRAIN_TIER2_MODEL=gpt-4o
# BRAIN_TIER2_API_KEY=

# --- Dashboard / Client ---
DASHBOARD_PORT=3000
CLIENT_PORT=8080
VITE_API_BASE=/api

# --- Ollama (shared local inference endpoint) ---
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434

# --- GPU Configuration ---
# Set to 'cpu' if no GPU available (slower but works)
NEXUS_DEVICE=cuda
NVIDIA_VISIBLE_DEVICES=all

# --- Storage ---
NEXUS_STORAGE_PATH=/data/nexus
NEXUS_AUDIO_STORAGE_PATH=/data/nexus/audio
NEXUS_SCREENSHOTS_PATH=/data/nexus/screenshots
NEXUS_MODELS_PATH=/models
