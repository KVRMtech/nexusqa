"""
Nexus Eyes Engine — Visual Intelligence.

Watches screen recordings/screenshots from KT sessions,
identifies UI elements, reads text from screens, and
understands visual workflows.

Pipeline:
1. Video input (MP4/WebM screen recording) or screenshot batches
2. Frame extraction with intelligent diffing (skip unchanged frames)
3. Application type classification (web UI, Excel, mainframe, PDF, etc.)
4. Visual parsing per application type
5. UI element extraction (buttons, fields, menus, tables)
6. Text extraction (OCR + layout analysis)
7. Visual state change detection (what changed between frames)
8. Emit structured visual data to Backbone via Shield

On-prem: Uses Qwen-VL or CogVLM2 locally. No screenshots leave the datacenter.
"""

from __future__ import annotations

import os
import uuid
import json
import asyncio
import hashlib
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional
from enum import Enum

from fastapi import Depends, HTTPException, UploadFile, File, Form, BackgroundTasks
from pydantic import BaseModel, Field

from nexus_sdk import NexusEngine, EngineConfig
from nexus_sdk.models import NexusRequest, NexusResponse, JobResponse, JobStatus
from nexus_sdk.auth import NexusUser, get_current_user
from nexus_sdk.events import NexusEvent, fire_stub_alert


# ─── Configuration ─────────────────────────────────────────────

class EyesConfig(EngineConfig):
    engine_name: str = "eyes"
    engine_port: int = 8003

    # Vision model
    vision_model: str = "qwen-vl"  # "qwen-vl" or "cogvlm2"
    vision_model_path: str = "./models/qwen-vl-chat"
    vision_device: str = "cuda"

    # Frame extraction
    frame_diff_threshold: float = 0.05   # 5% pixel change = new frame
    max_fps_extract: float = 2.0          # Extract max 2 frames/sec
    keyframe_only: bool = False

    # OCR
    ocr_engine: str = "easyocr"  # "easyocr" or "tesseract"

    # Storage
    frames_storage_path: str = "./data/frames"


# ─── Application Types ────────────────────────────────────────

class ApplicationType(str, Enum):
    WEB_UI = "web_ui"
    DESKTOP_APP = "desktop_app"
    EXCEL_SPREADSHEET = "excel_spreadsheet"
    MAINFRAME_3270 = "mainframe_3270"
    PDF_DOCUMENT = "pdf_document"
    EMAIL_CLIENT = "email_client"
    TERMINAL = "terminal"
    DATABASE_UI = "database_ui"
    UNKNOWN = "unknown"


# ─── Models ────────────────────────────────────────────────────

class UIElement(BaseModel):
    """A detected UI element in a screenshot."""
    element_type: str = Field(..., description="button, text_field, dropdown, label, table, menu, etc.")
    text: str = Field(default="", description="Text content of the element")
    bbox: list[float] = Field(default_factory=list, description="Bounding box [x1, y1, x2, y2]")
    confidence: float = Field(default=0.0)
    properties: dict = Field(default_factory=dict, description="Additional properties (enabled, selected, etc.)")


class FrameAnalysis(BaseModel):
    """Analysis result for a single frame/screenshot."""
    frame_id: str
    frame_index: int
    timestamp_seconds: float
    application_type: ApplicationType
    page_title: str = ""
    url_or_path: str = ""
    ui_elements: list[UIElement] = Field(default_factory=list)
    extracted_text: str = ""
    tables: list[dict] = Field(default_factory=list, description="Detected tables as structured data")
    state_changes: list[str] = Field(default_factory=list, description="Changes from previous frame")
    description: str = Field(default="", description="Natural language description of the screen")


class VisualAnalysisResult(BaseModel):
    """Full visual analysis of a video/screenshot batch."""
    job_id: str
    session_id: str
    total_frames_extracted: int
    total_frames_analyzed: int
    duration_seconds: float
    frames: list[FrameAnalysis]
    application_types_seen: list[str]
    workflow_summary: str = ""


class ScreenshotAnalyzeRequest(NexusRequest):
    """Request to analyze a single screenshot."""
    pass


# ─── Frame Extractor ──────────────────────────────────────────

class FrameExtractor:
    """
    Extracts meaningful frames from video recordings.
    
    Uses perceptual hashing to skip visually identical frames
    so we only process frames where something actually changed.
    """

    def __init__(self, config: EyesConfig):
        self.config = config
        self._event_bus = None
        self._stub_fallback_count: int = 0

    async def extract_frames(
        self,
        video_path: str,
        output_dir: str,
    ) -> list[dict]:
        """
        Extract unique frames from video.
        
        Returns list of {frame_path, timestamp, index}.
        """
        os.makedirs(output_dir, exist_ok=True)

        try:
            return await self._extract_with_opencv(video_path, output_dir)
        except ImportError:
            return self._stub_extract(video_path, output_dir)

    async def _extract_with_opencv(
        self,
        video_path: str,
        output_dir: str,
    ) -> list[dict]:
        """Extract frames using OpenCV with diff-based filtering."""
        import cv2
        import numpy as np

        cap = cv2.VideoCapture(video_path)
        fps = cap.get(cv2.CAP_PROP_FPS) or 30.0
        frame_interval = max(1, int(fps / self.config.max_fps_extract))

        frames = []
        prev_hash = None
        frame_idx = 0
        extracted_idx = 0

        while cap.isOpened():
            ret, frame = cap.read()
            if not ret:
                break

            if frame_idx % frame_interval == 0:
                # Compute perceptual hash
                gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
                small = cv2.resize(gray, (64, 64))
                current_hash = hashlib.md5(small.tobytes()).hexdigest()

                # Check if frame differs enough from previous
                if prev_hash is None or current_hash != prev_hash:
                    timestamp = frame_idx / fps
                    frame_path = os.path.join(output_dir, f"frame_{extracted_idx:05d}.png")
                    cv2.imwrite(frame_path, frame)

                    frames.append({
                        "frame_path": frame_path,
                        "timestamp": timestamp,
                        "index": extracted_idx,
                    })
                    extracted_idx += 1
                    prev_hash = current_hash

            frame_idx += 1

        cap.release()
        return frames

    def _stub_extract(self, video_path: str, output_dir: str) -> list[dict]:
        """Development stub when OpenCV is not available."""
        self._stub_fallback_count += 1
        logger.warning("eyes: frame extractor stub fallback #%d", self._stub_fallback_count)
        fire_stub_alert(
            self._event_bus, "eyes", "frame_extractor",
            fallback_count=self._stub_fallback_count,
            reason="OpenCV not installed",
        )
        return [
            {"frame_path": f"{output_dir}/frame_00000.png", "timestamp": 0.0, "index": 0},
            {"frame_path": f"{output_dir}/frame_00001.png", "timestamp": 3.0, "index": 1},
            {"frame_path": f"{output_dir}/frame_00002.png", "timestamp": 7.0, "index": 2},
        ]


# ─── Application Classifier ───────────────────────────────────

class ApplicationClassifier:
    """
    Classifies what application is shown in a screenshot.
    
    Phase 1: Heuristic-based (browser chrome detection, etc.)
    Phase 2: Fine-tuned vision model classification.
    """

    # Heuristic patterns for application detection
    BROWSER_INDICATORS = ["http://", "https://", "www.", ".com", ".org", ".net"]
    MAINFRAME_INDICATORS = ["CICS", "TSO", "ISPF", "3270", "===>"]
    EXCEL_INDICATORS = ["Sheet1", "Sheet2", "Cell", "Formula", "SUM(", "VLOOKUP("]

    def classify(self, extracted_text: str, frame_metadata: dict = None) -> ApplicationType:
        """Classify application type from extracted text and metadata."""
        text_lower = extracted_text.lower()

        # Check for mainframe patterns
        for indicator in self.MAINFRAME_INDICATORS:
            if indicator.lower() in text_lower:
                return ApplicationType.MAINFRAME_3270

        # Check for browser/web UI
        for indicator in self.BROWSER_INDICATORS:
            if indicator.lower() in text_lower:
                return ApplicationType.WEB_UI

        # Check for Excel
        for indicator in self.EXCEL_INDICATORS:
            if indicator.lower() in text_lower:
                return ApplicationType.EXCEL_SPREADSHEET

        # Check for terminal
        if any(kw in text_lower for kw in ["$", ">>>", "bash", "powershell", "cmd>"]):
            return ApplicationType.TERMINAL

        # Default
        return ApplicationType.DESKTOP_APP


# ─── OCR Engine ────────────────────────────────────────────────

class OCREngine:
    """
    Extracts text from screenshots.
    
    Uses EasyOCR (on-prem, GPU-accelerated) or Tesseract as fallback.
    """

    def __init__(self, config: EyesConfig):
        self.config = config
        self.reader = None
        self._event_bus = None
        self._stub_fallback_count: int = 0

    async def load(self):
        """Initialize OCR engine."""
        try:
            import easyocr
            self.reader = easyocr.Reader(
                ["en"],
                gpu=(self.config.vision_device == "cuda"),
                model_storage_directory="./models/easyocr",
            )
        except ImportError:
            self.reader = None

    def extract_text(self, image_path: str) -> tuple[str, list[dict]]:
        """
        Extract text from image.
        
        Returns (full_text, text_regions).
        text_regions: [{text, bbox, confidence}]
        """
        if self.reader is None:
            return self._stub_ocr(image_path)

        results = self.reader.readtext(image_path)
        text_regions = []
        full_text_parts = []

        for bbox, text, confidence in results:
            text_regions.append({
                "text": text,
                "bbox": [
                    float(bbox[0][0]), float(bbox[0][1]),
                    float(bbox[2][0]), float(bbox[2][1]),
                ],
                "confidence": float(confidence),
            })
            full_text_parts.append(text)

        return " ".join(full_text_parts), text_regions

    def _stub_ocr(self, image_path: str) -> tuple[str, list[dict]]:
        """Development stub."""
        self._stub_fallback_count += 1
        logger.warning("eyes: OCR stub fallback #%d", self._stub_fallback_count)
        fire_stub_alert(
            self._event_bus, "eyes", "ocr",
            fallback_count=self._stub_fallback_count,
            reason="easyocr not installed",
        )
        return (
            "[Stub] OCR not available. Install easyocr for text extraction.",
            [{"text": "[Stub]", "bbox": [0, 0, 100, 20], "confidence": 0.0}],
        )


# ─── Visual Analyzer ──────────────────────────────────────────

class VisualAnalyzer:
    """
    Analyzes screenshots using a vision-language model via Ollama.
    
    Phase 2 implementation: Uses Llava (7B) through Ollama for
    real visual understanding of UI screenshots.
    Falls back to heuristic analysis if Ollama is unavailable.
    """

    def __init__(self, config: EyesConfig):
        self.config = config
        self.model = None
        self._ollama_available = False
        self._ollama_model = "llava:7b"
        self._http_client = None
        self._ollama_base_url = os.environ.get("OLLAMA_BASE_URL", "http://localhost:11434")

    async def load_model(self):
        """Connect to Ollama and verify Llava model availability."""
        try:
            import httpx
            self._http_client = httpx.AsyncClient(
                base_url=self._ollama_base_url,
                timeout=120.0,
            )
            resp = await self._http_client.get("/api/tags")
            if resp.status_code == 200:
                models = resp.json().get("models", [])
                model_names = [m.get("name", "") for m in models]
                if any(self._ollama_model in n for n in model_names):
                    self._ollama_available = True
                    self.model = self._ollama_model
                    import logging
                    logging.getLogger(__name__).info(
                        "eyes: Ollama Llava model ready for visual analysis"
                    )
                    return
                # Model not pulled — Ollama is running but model missing
                import logging
                logging.getLogger(__name__).warning(
                    "eyes: Ollama running but '%s' not found. Run: ollama pull %s",
                    self._ollama_model, self._ollama_model,
                )
        except Exception as e:
            import logging
            logging.getLogger(__name__).warning(
                "eyes: Ollama connection failed (%s) — using heuristic visual analysis", e
            )
            if self._http_client:
                await self._http_client.aclose()
                self._http_client = None

    async def analyze_frame(
        self,
        frame_path: str,
        ocr_text: str,
        app_type: ApplicationType,
        previous_description: str = "",
    ) -> dict:
        """
        Analyze a single frame using Ollama Llava or heuristic fallback.
        """
        if self._ollama_available and self._http_client is not None:
            try:
                return await self._ollama_analyze(frame_path, ocr_text, app_type, previous_description)
            except Exception as e:
                import logging
                logging.getLogger(__name__).warning("eyes: Ollama analysis failed (%s), using heuristic", e)

        return self._heuristic_analyze(frame_path, ocr_text, app_type, previous_description)

    async def _ollama_analyze(
        self,
        frame_path: str,
        ocr_text: str,
        app_type: ApplicationType,
        previous_description: str,
    ) -> dict:
        """Analyze frame using Ollama Llava multimodal model."""
        import base64

        # Read and encode the image
        with open(frame_path, "rb") as f:
            image_b64 = base64.b64encode(f.read()).decode("utf-8")

        prompt = (
            "You are analyzing a screenshot from a software application for QA testing purposes.\n"
            f"Application type detected: {app_type.value}\n"
            f"OCR text extracted: {ocr_text[:1000]}\n\n"
            "Please analyze this screenshot and return a JSON object with:\n"
            '1. "ui_elements": array of objects with {element_type, text, confidence} for each UI element (buttons, fields, labels, dropdowns, tables, menus)\n'
            '2. "description": a natural language description of what the screen shows and what workflow step it represents\n'
            '3. "tables": array of any data tables detected (empty array if none)\n'
            '4. "page_title": the page or dialog title if visible\n'
            "Return ONLY valid JSON."
        )

        payload = {
            "model": self._ollama_model,
            "messages": [
                {
                    "role": "user",
                    "content": prompt,
                    "images": [image_b64],
                }
            ],
            "stream": False,
            "format": "json",
            "options": {"temperature": 0.1, "num_predict": 2048},
        }

        resp = await self._http_client.post("/api/chat", json=payload, timeout=120.0)
        if resp.status_code == 200:
            data = resp.json()
            content = data.get("message", {}).get("content", "{}")
            try:
                import json
                parsed = json.loads(content)
                ui_elements = []
                for elem in parsed.get("ui_elements", []):
                    ui_elements.append(UIElement(
                        element_type=elem.get("element_type", "unknown"),
                        text=elem.get("text", ""),
                        confidence=elem.get("confidence", 0.8),
                        properties=elem.get("properties", {}),
                    ))
                return {
                    "ui_elements": ui_elements,
                    "description": parsed.get("description", ""),
                    "tables": parsed.get("tables", []),
                    "page_title": parsed.get("page_title", ""),
                }
            except (json.JSONDecodeError, KeyError):
                pass

        # If Ollama returned non-JSON, fall back to heuristic
        return self._heuristic_analyze(frame_path, ocr_text, app_type, previous_description)

    def _heuristic_analyze(
        self,
        frame_path: str,
        ocr_text: str,
        app_type: ApplicationType,
        previous_description: str,
    ) -> dict:
        """Heuristic analysis when vision model is not available."""
        ui_elements = []
        import re
        button_patterns = re.findall(
            r'\b(Submit|Cancel|Save|Next|Back|Continue|OK|Apply|Search|Login|Logout|'
            r'Calculate|Quote|Bind|Issue|Renew|Endorse)\b',
            ocr_text, re.IGNORECASE
        )
        for btn_text in button_patterns:
            ui_elements.append(UIElement(
                element_type="button",
                text=btn_text,
                confidence=0.7,
            ))
        field_patterns = re.findall(r'([A-Za-z\s]+)[:]\s*([\w\s@.\-]+)', ocr_text)
        for label, value in field_patterns[:20]:
            ui_elements.append(UIElement(
                element_type="text_field",
                text=f"{label.strip()}: {value.strip()}",
                confidence=0.6,
                properties={"label": label.strip(), "value": value.strip()},
            ))
        return {
            "ui_elements": ui_elements,
            "description": f"Screen showing {app_type.value} with {len(ui_elements)} detected elements",
            "tables": [],
        }


# ─── The Eyes Engine ───────────────────────────────────────────

class EyesEngine(NexusEngine):
    def __init__(self):
        self.cfg = EyesConfig()
        super().__init__(
            name="eyes",
            version="0.1.0",
            config=self.cfg,
            description="Visual Intelligence Engine",
        )
        self.frame_extractor = FrameExtractor(self.cfg)
        self.app_classifier = ApplicationClassifier()
        self.ocr = OCREngine(self.cfg)
        self.visual_analyzer = VisualAnalyzer(self.cfg)

        # GPU concurrency guard — serializes all GPU inference in this process
        self._gpu_semaphore = asyncio.Semaphore(1)

    async def on_startup(self):
        """Load models."""
        os.makedirs(self.cfg.frames_storage_path, exist_ok=True)
        # Wire event bus into helper classes
        self.frame_extractor._event_bus = self.event_bus
        self.ocr._event_bus = self.event_bus
        await self.ocr.load()
        await self.visual_analyzer.load_model()

        # Report modes
        self.health.set_mode("ocr", "real" if getattr(self.ocr, 'reader', None) else "stub")
        self.health.set_mode("visual_analyzer", f"ollama/{self.visual_analyzer._ollama_model}" if self.visual_analyzer._ollama_available else "heuristic")

        # Check cv2 availability for frame extraction
        try:
            import cv2
            self.health.set_mode("frame_extraction", f"opencv {cv2.__version__}")
        except ImportError:
            logger.warning("eyes: cv2 (OpenCV) not available — frame extraction will use stub")
            self.health.set_mode("frame_extraction", "stub (no cv2)")

    def register_routes(self, app):

        # ── Analyze Video Recording ────────────────────────────

        @app.post("/api/v1/eyes/analyze-video", response_model=JobResponse)
        async def analyze_video(
            background_tasks: BackgroundTasks,
            video: UploadFile = File(..., description="Screen recording (MP4/WebM)"),
            tenant_id: str = Form(...),
            session_id: str = Form(default_factory=lambda: str(uuid.uuid4())),
            user: NexusUser = Depends(get_current_user),
        ):
            """Upload a screen recording for visual analysis."""
            job_id = str(uuid.uuid4())

            # Save video
            video_dir = Path(self.cfg.frames_storage_path) / tenant_id / session_id
            video_dir.mkdir(parents=True, exist_ok=True)
            video_path = video_dir / f"{job_id}_{video.filename}"

            content = await video.read()
            video_path.write_bytes(content)

            await self.job_store.set_job(job_id, {
                "job_id": job_id,
                "status": JobStatus.QUEUED.value,
                "tenant_id": tenant_id,
                "session_id": session_id,
                "type": "video",
                "created_at": datetime.now(timezone.utc).isoformat(),
                "result": None,
                "error": None,
            })

            background_tasks.add_task(
                self._process_video,
                job_id, str(video_path), session_id, tenant_id,
            )

            return JobResponse(
                success=True,
                engine="eyes",
                engine_version="0.1.0",
                job_id=job_id,
                status=JobStatus.QUEUED,
            )

        # ── Analyze Single Screenshot ──────────────────────────

        @app.post("/api/v1/eyes/analyze-screenshot")
        async def analyze_screenshot(
            screenshot: UploadFile = File(..., description="Screenshot (PNG/JPG)"),
            tenant_id: str = Form(...),
            session_id: str = Form(default_factory=lambda: str(uuid.uuid4())),
            user: NexusUser = Depends(get_current_user),
        ):
            """Analyze a single screenshot immediately (synchronous)."""
            start = time.monotonic()

            # Save screenshot
            temp_dir = Path(self.cfg.frames_storage_path) / tenant_id / "screenshots"
            temp_dir.mkdir(parents=True, exist_ok=True)
            img_path = temp_dir / f"{uuid.uuid4()}_{screenshot.filename}"

            content = await screenshot.read()
            img_path.write_bytes(content)

            # OCR
            async with self._gpu_semaphore:
                extracted_text, text_regions = self.ocr.extract_text(str(img_path))

            # Classify application
            app_type = self.app_classifier.classify(extracted_text)

            # Analyze
            async with self._gpu_semaphore:
                analysis = await self.visual_analyzer.analyze_frame(
                    str(img_path), extracted_text, app_type,
                )

            elapsed_ms = (time.monotonic() - start) * 1000

            return {
                "success": True,
                "processing_time_ms": round(elapsed_ms, 2),
                "frame": FrameAnalysis(
                    frame_id=str(uuid.uuid4()),
                    frame_index=0,
                    timestamp_seconds=0.0,
                    application_type=app_type,
                    ui_elements=analysis.get("ui_elements", []),
                    extracted_text=extracted_text,
                    tables=analysis.get("tables", []),
                    description=analysis.get("description", ""),
                ).model_dump(),
            }

        # ── Get Job Status ─────────────────────────────────────

        @app.get("/api/v1/eyes/jobs/{job_id}")
        async def get_job(
            job_id: str,
            user: NexusUser = Depends(get_current_user),
        ):
            job = await self.job_store.get_job(job_id)
            if not job:
                raise HTTPException(status_code=404, detail="Job not found")
            return job

        # ── Get Session Frames ─────────────────────────────────

        @app.get("/api/v1/eyes/sessions/{session_id}/frames")
        async def get_session_frames(
            session_id: str,
            user: NexusUser = Depends(get_current_user),
        ):
            """Get all analyzed frames for a KT session."""
            all_jobs = await self.job_store.list_jobs(limit=500)
            for job in all_jobs:
                if (
                    job.get("session_id") == session_id
                    and job.get("status") == JobStatus.COMPLETED.value
                    and job.get("result")
                ):
                    return job.get("result")

            raise HTTPException(status_code=404, detail="No visual analysis found for session")

    async def _process_video(
        self,
        job_id: str,
        video_path: str,
        session_id: str,
        tenant_id: str,
    ):
        """Background: full video analysis pipeline."""
        await self.job_store.update_job(job_id, status=JobStatus.PROCESSING.value)

        try:
            start = time.monotonic()

            # Step 1: Extract frames
            frames_dir = str(Path(video_path).parent / f"{job_id}_frames")
            raw_frames = await self.frame_extractor.extract_frames(video_path, frames_dir)

            # Step 2: Analyze each frame
            analyzed_frames = []
            prev_description = ""

            for i, frame_info in enumerate(raw_frames):
                frame_path = frame_info["frame_path"]
                timestamp = frame_info["timestamp"]

                # OCR
                async with self._gpu_semaphore:
                    extracted_text, text_regions = self.ocr.extract_text(frame_path)

                # Classify
                app_type = self.app_classifier.classify(extracted_text)

                # Visual analysis
                async with self._gpu_semaphore:
                    analysis = await self.visual_analyzer.analyze_frame(
                        frame_path, extracted_text, app_type, prev_description,
                    )

                frame_analysis = FrameAnalysis(
                    frame_id=str(uuid.uuid4()),
                    frame_index=i,
                    timestamp_seconds=timestamp,
                    application_type=app_type,
                    ui_elements=analysis.get("ui_elements", []),
                    extracted_text=extracted_text,
                    tables=analysis.get("tables", []),
                    description=analysis.get("description", ""),
                )
                analyzed_frames.append(frame_analysis)
                prev_description = analysis.get("description", "")

            # Step 3: Build result
            elapsed = time.monotonic() - start
            app_types_seen = list(set(f.application_type.value for f in analyzed_frames))

            result = VisualAnalysisResult(
                job_id=job_id,
                session_id=session_id,
                total_frames_extracted=len(raw_frames),
                total_frames_analyzed=len(analyzed_frames),
                duration_seconds=max((f.timestamp_seconds for f in analyzed_frames), default=0),
                frames=analyzed_frames,
                application_types_seen=app_types_seen,
            )

            await self.job_store.update_job(
                job_id,
                status=JobStatus.COMPLETED.value,
                result=result.model_dump(),
                processing_time_seconds=round(elapsed, 2),
            )

            # Emit event
            if self.event_bus:
                await self.event_bus.publish(NexusEvent(
                    event_type="eyes.analysis.completed",
                    tenant_id=tenant_id,
                    trace_id=job_id,
                    engine="eyes",
                    session_id=session_id,
                    data={
                        "job_id": job_id,
                        "session_id": session_id,
                        "frame_count": len(analyzed_frames),
                        "application_types": app_types_seen,
                    },
                ))

        except Exception as e:
            await self.job_store.update_job(
                job_id,
                status=JobStatus.FAILED.value,
                error=str(e),
            )


# ─── Entry Point ──────────────────────────────────────────────

def main():
    engine = EyesEngine()
    engine.run()


if __name__ == "__main__":
    main()
