"""
Nexus Platform API — Cross-cutting backend for all UI module pages.

ALL data is persisted in PostgreSQL via async SQLAlchemy.
NO in-memory stores. NO hardcoded fake data.

Routes:
  /api/v1/sessions/*         — Knowledge capture session management
  /api/v1/sme/*              — SME profile aggregation
  /api/v1/contradictions/*   — Contradiction tracking & resolution
  /api/v1/guardrails/*       — AI confidence pipeline & review queue
  /api/v1/traceability/*     — Living traceability matrix
  /api/v1/tests/*            — Test suite & run management
  /api/v1/data-forge/*       — Test data config & results
  /api/v1/compliance/*       — Jurisdiction compliance tracking
  /api/v1/insights/*         — Executive KPIs, ROI, risks, trends (REAL aggregated)
  /api/v1/admin/*            — Engine grid, resources, integrations, audit, users

Port: 8091
"""
from __future__ import annotations

import os
import sys
import uuid
import time
import logging
from datetime import datetime, timezone, timedelta
from typing import Optional

import httpx
import structlog
from contextlib import asynccontextmanager
from fastapi import FastAPI, Request, Query, Path, HTTPException, Depends
from fastapi.middleware.cors import CORSMiddleware
from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials
from pydantic import BaseModel, Field
from pydantic_settings import BaseSettings

# SQLAlchemy async
from sqlalchemy import select, func, text, desc, and_
from sqlalchemy.ext.asyncio import (
    AsyncEngine,
    AsyncSession,
    async_sessionmaker,
    create_async_engine,
)

logger = structlog.get_logger()


# ─── Configuration ─────────────────────────────────────────────

class PlatformAPIConfig(BaseSettings):
    host: str = "0.0.0.0"
    port: int = 8091

    # JWT
    jwt_secret: str = "nexus-change-in-production"
    jwt_algorithm: str = "HS256"

    # Engine URLs (for aggregation)
    auth_service_url: str = "http://localhost:8000"
    shield_engine_url: str = "http://localhost:8001"
    ears_engine_url: str = "http://localhost:8002"
    eyes_engine_url: str = "http://localhost:8003"
    heart_engine_url: str = "http://localhost:8004"
    backbone_engine_url: str = "http://localhost:8005"
    nerves_engine_url: str = "http://localhost:8006"
    legs_engine_url: str = "http://localhost:8007"
    hands_engine_url: str = "http://localhost:8008"
    spine_engine_url: str = "http://localhost:8009"
    mouth_engine_url: str = "http://localhost:8010"

    # Database
    postgres_host: str = "localhost"
    postgres_port: int = 5432
    postgres_db: str = "nexus"
    postgres_user: str = "nexus"
    postgres_password: str = "nexus-dev"
    redis_host: str = "localhost"
    redis_port: int = 6379
    redis_password: str = "nexus-redis-dev"
    redis_url: str = "redis://localhost:6379/0"

    @property
    def database_url(self) -> str:
        return (
            f"postgresql+asyncpg://{self.postgres_user}:{self.postgres_password}"
            f"@{self.postgres_host}:{self.postgres_port}/{self.postgres_db}"
        )

    model_config = {"env_file": ".env", "extra": "ignore"}


config = PlatformAPIConfig()


# ─── Database Layer ────────────────────────────────────────────

sdk_path = os.path.join(os.path.dirname(__file__), "..", "..", "sdk", "nexus-sdk")
if sdk_path not in sys.path:
    sys.path.insert(0, sdk_path)

from nexus_sdk.db import Base
from nexus_sdk.db.models import (
