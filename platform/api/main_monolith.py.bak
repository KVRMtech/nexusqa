)

# Test Case CRUD router
from routers.test_cases import router as test_cases_router, init_router as init_test_cases

_engine: Optional[AsyncEngine] = None
_session_factory: Optional[async_sessionmaker[AsyncSession]] = None
_db_connected: bool = False


async def _init_db():
    global _engine, _session_factory, _db_connected
    try:
        _engine = create_async_engine(
            config.database_url,
            pool_size=20,
            max_overflow=10,
            pool_pre_ping=True,
            pool_recycle=3600,
            echo=False,
        )
        _session_factory = async_sessionmaker(
            bind=_engine, class_=AsyncSession, expire_on_commit=False
        )
        async with _engine.begin() as conn:
            await conn.run_sync(Base.metadata.create_all)
        async with _engine.connect() as conn:
            await conn.execute(text("SELECT 1"))
        _db_connected = True
        logger.info("platform_api.db_connected", url=config.postgres_host)
    except Exception as e:
        logger.warning("platform_api.db_failed", error=str(e))
        _db_connected = False


# ─── Lifespan ──────────────────────────────────────────────────

@asynccontextmanager
async def lifespan(application: FastAPI):
    await _init_db()
    await _cache.connect()
    # Initialize test case CRUD router with DB session factory
    if _session_factory:
        init_test_cases(_session_factory)
    logger.info("platform_api.started", routes=28, port=config.port, db=_db_connected, cache=_cache.is_connected)
    yield
    await _cache.close()
    await _http.aclose()
    if _engine:
        await _engine.dispose()
    logger.info("platform_api.stopped")


app = FastAPI(
    title="Nexus Platform API",
    description="Cross-cutting API — PostgreSQL-backed, zero hardcoded data",
    version="0.2.0",
    lifespan=lifespan,
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=[o.strip() for o in os.getenv("CORS_ALLOWED_ORIGINS", "http://localhost:3000,http://localhost:5173,http://localhost:8080").split(",") if o.strip()],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Register sub-routers
app.include_router(test_cases_router)


# ─── Security Headers Middleware ───────────────────────────────

@app.middleware("http")
async def security_headers(request: Request, call_next):
    response = await call_next(request)
    response.headers["X-Content-Type-Options"] = "nosniff"
    response.headers["X-Frame-Options"] = "DENY"
    response.headers["X-XSS-Protection"] = "1; mode=block"
    response.headers["Referrer-Policy"] = "strict-origin-when-cross-origin"
    response.headers["Cache-Control"] = "no-store"
    response.headers["Strict-Transport-Security"] = "max-age=31536000; includeSubDomains"
    return response


# ─── JWT Authentication ────────────────────────────────────────

_bearer = HTTPBearer(auto_error=False)

# Public routes that skip auth (health checks, docs)
_PUBLIC_PATHS = frozenset({"/", "/health", "/docs", "/openapi.json", "/redoc"})


async def get_current_user(
    request: Request,
    credentials: HTTPAuthorizationCredentials = Depends(_bearer),
):
    """Validate JWT and return decoded user context.
    
    Attaches user info to request.state for use by route handlers.
    """
    if credentials is None:
        raise HTTPException(status_code=401, detail="Authorization header required")
    try:
        import jwt as pyjwt
        payload = pyjwt.decode(
            credentials.credentials,
            config.jwt_secret,
            algorithms=[config.jwt_algorithm],
        )
        request.state.user = {
            "user_id": payload.get("sub", "anonymous"),
            "tenant_id": payload.get("tenant_id", "default"),
            "email": payload.get("email", ""),
            "role": payload.get("role", "viewer"),
        }
        return request.state.user
    except Exception:
        raise HTTPException(status_code=401, detail="Invalid or expired token")


@app.middleware("http")
async def jwt_auth_middleware(request: Request, call_next):
    """Enforce JWT on all API routes (except public paths)."""
    path = request.url.path.rstrip("/")
    if path in _PUBLIC_PATHS or path.startswith("/docs") or path.startswith("/redoc"):
        return await call_next(request)
    
    auth_header = request.headers.get("authorization", "")
    if auth_header.startswith("Bearer "):
        token = auth_header[7:]
        try:
            import jwt as pyjwt
            payload = pyjwt.decode(
                token, config.jwt_secret, algorithms=[config.jwt_algorithm],
            )
            request.state.user = {
                "user_id": payload.get("sub", "anonymous"),
                "tenant_id": payload.get("tenant_id", "default"),
                "email": payload.get("email", ""),
                "role": payload.get("role", "viewer"),
            }
        except Exception:
            pass  # Individual routes use Depends(get_current_user) for strict enforcement
    
    return await call_next(request)


_http = httpx.AsyncClient(timeout=30.0)

# Redis cache for expensive queries
_cache_dir = os.path.dirname(os.path.abspath(__file__))
if _cache_dir not in sys.path:
    sys.path.insert(0, _cache_dir)
from cache import RedisCache  # platform/api/cache.py
_cache = RedisCache(
    host=config.redis_host,
    port=config.redis_port,
    password=config.redis_password,
)


# ─── Helpers ───────────────────────────────────────────────────

def _new_id() -> str:
    return str(uuid.uuid4())


def _utc_now() -> datetime:
    return datetime.now(timezone.utc)


def _row_to_dict(row) -> dict:
    d = {}
    for c in row.__table__.columns:
        val = getattr(row, c.name)
        if isinstance(val, datetime):
            val = val.isoformat()
        d[c.name] = val
    return d


def _require_db():
    if not _session_factory:
        raise HTTPException(503, "Database not connected")


# ─── Health ───────────────────────────────────────────────────

@app.get("/health")
async def health():
    return {
        "status": "healthy",
        "service": "nexus-platform-api",
        "routes": 28,
        "database": "connected" if _db_connected else "disconnected",
        "cache": "connected" if _cache.is_connected else "disabled",
    }


# ═══ SESSIONS (Module 1 & 2) ═══

@app.get("/api/v1/sessions")
async def list_sessions(tenant_id: str = Query("t-1")):
    _require_db()
    async with _session_factory() as db:
        result = await db.execute(
            select(SessionRow)
            .where(SessionRow.tenant_id == tenant_id)
            .order_by(desc(SessionRow.created_at))
        )
        return [
            {k: v for k, v in _row_to_dict(r).items() if k not in ("events", "transcript")}
            for r in result.scalars().all()
        ]


@app.get("/api/v1/sessions/{session_id}")
async def get_session(session_id: str = Path(...)):
    _require_db()
    async with _session_factory() as db:
        row = await db.get(SessionRow, session_id)
        if not row:
            raise HTTPException(404, f"Session {session_id} not found")
        d = _row_to_dict(row)
        return {k: v for k, v in d.items() if k not in ("events", "transcript")}


@app.get("/api/v1/sessions/{session_id}/events")
async def get_session_events(session_id: str = Path(...)):
    _require_db()
    async with _session_factory() as db:
        row = await db.get(SessionRow, session_id)
        if not row:
            raise HTTPException(404, f"Session {session_id} not found")
        return row.events or []


@app.get("/api/v1/sessions/{session_id}/transcript")
async def get_session_transcript(session_id: str = Path(...)):
    _require_db()
    async with _session_factory() as db:
        row = await db.get(SessionRow, session_id)
        if not row:
            raise HTTPException(404, f"Session {session_id} not found")
        return row.transcript or []


